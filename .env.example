# ─────────────────────────────────────────────
# notify-hub — Environment Variables
# Copy to .env and fill in real values.
# ─────────────────────────────────────────────

# === App ===
APP_NAME=notify-hub
APP_ENV=development          # development | staging | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR

# === Postgres ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=notify_hub
POSTGRES_USER=notify_hub
POSTGRES_PASSWORD=change_me_in_prod
DATABASE_URL=postgresql+asyncpg://notify_hub:change_me_in_prod@localhost:5432/notify_hub

# === Redis (Celery broker + result backend) ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# === Telegram ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# === Slack ===
SLACK_WEBHOOK_URL=

# === Discord ===
DISCORD_WEBHOOK_URL=

# === Email (SMTP) ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# === Security ===
SECRET_KEY=change_me_to_a_long_random_string
WEBHOOK_SIGNING_SECRET=change_me_too

# === Rate limiting / Retry ===
RATE_LIMIT_PER_MINUTE=60
RETRY_MAX_ATTEMPTS=5
RETRY_BACKOFF_BASE=2
